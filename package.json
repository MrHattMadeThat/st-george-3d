{
  "name": "st-george-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cartoon 3D stage of St. George, NB and its surroundings in the Granite Town era (1874-1876).",
  "scripts": {
    "dev": "vite --port 5631 --strictPort",
    "build:data": "node scripts/build-terrain.mjs && node scripts/build-railway.mjs",
    "build": "vite build",
    "preview": "vite preview --port 5632 --strictPort"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "vite": "^8.3.0"
  }
}
